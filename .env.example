# Environment Configuration Example
# Copy this file to .env and configure for your deployment

# Site URL (Canonical URL & OpenGraph base)
VITE_SITE_URL=https://example.com

# Analytics Provider & ID (leave empty or set 'none' to disable)
# Supported: 'plausible' | 'umami' | 'none'
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_DOMAIN=restaurant.example.com
VITE_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js

# Form API Endpoint (optional - if using external form backend or serverless handler)
# When empty, client falls back to WhatsApp direct reservation transmission
VITE_FORM_ENDPOINT=

# Prevent search engine indexing on staging/preview deployments (set 'true' for preview, 'false' for production)
VITE_BLOCK_INDEXING=false
